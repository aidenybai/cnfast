{
  "name": "@cnfast/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run cnfast#build",
    "dev": "vp run cnfast#dev",
    "test": "vp run cnfast#test",
    "typecheck": "vp run cnfast#typecheck",
    "bench": "pnpm --filter cnfast bench",
    "bench:report": "pnpm --filter cnfast bench:report",
    "bench:setup": "pnpm --filter cnfast bench:setup",
    "benchmark:dev": "vp run @cnfast/benchmark#dev",
    "benchmark:build": "vp run @cnfast/benchmark#build",
    "size": "pnpm --filter cnfast size",
    "iter": "pnpm --filter cnfast iter",
    "deopt": "pnpm --filter cnfast deopt",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "publint": "vp run cnfast#publint",
    "sherif": "sherif -p ./packages/benchmark",
    "changeset": "nr build && changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@antfu/ni": "^30.5.0",
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "sherif": "^1.13.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.24.0"
}
